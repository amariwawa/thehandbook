      "topic": "Polynomials",
      "section": "General",
      "subtopic": "Polynomials",
      "difficulty": "easy",
      "question": "Solve simultaneously: 2x + y = 6 and x - y = 0.",
      "options": {
        "A": "x = 2, y = 2",
        "B": "x = 1, y = 3",
        "C": "x = 4, y = 0",
        "D": "x = 3, y = 1"
      },
      "answer": "A",
      "explanation": "From x - y = 0, x = y + 0. Substituting into 2x + y = 6: 2(y + 0) + y = 6 → 3y = 6 → y = 2, so x = 2."
    },
