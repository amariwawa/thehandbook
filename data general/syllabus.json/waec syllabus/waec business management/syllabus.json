      ]
    },
    {
      "topic_number": 12,
      "topic": "Entrepreneurship",
      "subtopics": [
        "Concept of entrepreneurship",
        "Characteristics of an entrepreneur",
        "Role of entrepreneurship in economic development",
        "Sources of business ideas",
        "Business plan and feasibility study"
      ]
    }
