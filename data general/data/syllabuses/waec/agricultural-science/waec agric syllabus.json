{
  "exam": "WAEC",
  "subject": "Agricultural Science",
  "syllabus_sections": [
    {
      "section": "BASIC CONCEPTS",
      "topics": [
        {
          "title": "Meaning and Importance of Agriculture",
          "details": ["Definition and branches", "Importance to individual, community, and nation"]
        },
        {
          "title": "Problems of Agricultural Development",
          "details": ["Land tenure", "Finance", "Infrastructure", "Extension services", "Mechanization", "Environmental degradation"]
        },
        {
          "title": "Subsistence vs Commercial Agriculture",
          "details": ["Characteristics", "Differences", "Advantages and Disadvantages", "Specific problems"]
        },
        {
          "title": "Institutional Roles",
          "details": ["Government: Finance, subsidies, education, and extension", "NGO roles", "Land Use Act/Decree and reforms"]
        }
      ]
    },
    {
      "section": "AGRICULTURAL ECOLOGY",
      "topics": [
        {
          "title": "Ecosystem and Land Use",
          "details": ["Biotic and abiotic components", "Land characteristics", "Agricultural vs Non-agricultural land use", "Factors affecting land availability"]
        },
        {
          "title": "Environmental Factors",
          "details": ["Climatic (rainfall, temp, etc.)", "Biotic (parasites, soil organisms, pests)", "Edaphic (pH, texture, structure)"]
        },
        {
          "title": "Soil Science",
          "details": ["Rock formation (Igneous, Sedimentary, Metamorphic)", "Soil formation factors and profile development", "Chemical and biological composition", "Plant nutrient cycles (Nitrogen, Carbon, Water, Phosphorus)"]
        },
        {
          "title": "Water and Waste Management",
          "details": ["Irrigation types (Overhead, Surface, Underground)", "Drainage systems", "Agricultural pollution causes and effects"]
        }
      ]
    },
    {
      "section": "AGRICULTURAL ENGINEERING AND MECHANIZATION",
      "topics": [
        {
          "title": "Farm Tools and Machinery",
          "details": ["Simple farm tools", "Farm machinery (Tractor, Bulldozer, Sheller, etc.)", "Tractor-coupled implements (Ploughs, Harrows, Ridgers, etc.)", "Maintenance practices"]
        },
        {
          "title": "Mechanization and Power",
          "details": ["Meaning and mechanized operations", "Advantages and limitations", "Sources of farm power"]
        },
        {
          "title": "Farm Surveying and Planning",
          "details": ["Survey equipment and maintenance", "Farm planning factors", "Farmstead design and layout"]
        }
      ]
    },
    {
      "section": "CROP PRODUCTION AND PROTECTION",
      "topics": [
        {
          "title": "Crop Husbandry",
          "details": ["Classification (Uses, Life cycle, Morphology)", "Selected crop management: Cereals, Pulses, Roots, Vegetables, Fruits, Oils, Fibres, etc.", "Pasture and Forage crops"]
        },
        {
          "title": "Forestry and Ornamentals",
          "details": ["Forest management and regulations", "Agro-forestry practices", "Ornamental plants cultivation and maintenance"]
        },
        {
          "title": "Crop Protection",
          "details": ["Crop diseases (Smut, Blast, Rust, Mosaic, etc.)", "Crop pests (Insect and Non-insect classification)", "Weed characteristics and control methods"]
        },
        {
          "title": "Crop Improvement",
          "details": ["Methods: Introduction, Selection, Breeding", "Mendel’s laws of inheritance"]
        }
      ]
    },
    {
      "section": "ANIMAL PRODUCTION",
      "topics": [
        {
          "title": "Livestock Management",
          "details": ["Classification (Habitat, Uses)", "Anatomy and Physiology (Digestive, Circulatory, Respiratory systems)", "Reproduction and Environmental physiology", "Animal Nutrition and Ration types"]
        },
        {
          "title": "Animal Health",
          "details": ["Viral, Bacterial, Fungal, and Protozoal diseases", "Endoparasites and Ectoparasites", "Prevention and control methods"]
        },
        {
          "title": "Fisheries and Apiculture",
          "details": ["Aquaculture: Fish, Shrimp, and Crab farming", "Bee keeping (Traditional and Modern)"]
        },
        {
          "title": "Animal Improvement",
          "details": ["Aims and methods", "Artificial Insemination"]
        }
      ]
    },
    {
      "section": "AGRICULTURAL ECONOMICS AND EXTENSION",
      "topics": [
        {
          "title": "Economic Principles",
          "details": ["Scarcity, Choice, and Scale of Preference", "Law of diminishing returns", "Factors of production", "Demand and Supply principles"]
        },
        {
          "title": "Farm Management and Finance",
          "details": ["Functions of a farm manager", "Agricultural finance sources", "Classes of credit", "Capital markets", "Farm records and accounts (Balance sheet, P&L)"]
        },
        {
          "title": "Marketing and Insurance",
          "details": ["Marketing agents and functions", "Exporting guidelines", "Agricultural insurance policies and premiums"]
        },
        {
          "title": "Agricultural Extension",
          "details": ["Extension methods (Individual vs Group)", "West African extension programmes (ADP, NDE, etc.)"]
        }
      ]
    },
    {
      "section": "PRACTICAL AGRICULTURAL SCIENCE",
      "topics": [
        "Soil profile and Rock identification",
        "Laboratory analysis of soil (Sedimentation, moisture, pH)",
        "Identification of farm tools and implements",
        "Identification of seeds, pests, and weeds",
        "Anatomy: Major internal organs of farm animals",
        "Animal management: Culling, ear-notching, castration, etc."
      ]
    }
  ]
}